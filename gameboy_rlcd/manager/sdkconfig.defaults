# The ROM manager: same board, same card, same partition table as the emulator,
# but it has the internal RAM to itself, which is why it is a separate app at all.

# Share the emulator's partition table, from the parent directory. It defines
# ota_0 (the emulator) and ota_1 (this).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Long file names in UTF-8, exactly as the emulator has them. Without this the
# manager sees 8.3 names only: "POKEMON.GB", plus a "~1" alias of every file
# with a long name, which is both wrong and counted twice.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# Uploads stream through PSRAM buffers, so keep the internal pool for the WiFi
# driver and the server's task stack.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=6

# The main task drives the screen and the buttons, and nothing else runs here.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_FREERTOS_HZ=1000
