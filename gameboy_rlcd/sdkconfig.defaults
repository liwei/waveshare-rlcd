# Waveshare ESP32-S3-RLCD-4.2: ESP32-S3-WROOM-1-N16R8 (16 MB flash, 8 MB OPI PSRAM)

CONFIG_IDF_TARGET="esp32s3"

# ---- Flash and PSRAM ------------------------------------------------------
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# ---- CPU ------------------------------------------------------------------
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000

# ---- Partition table ------------------------------------------------------
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- Console on the native USB Serial/JTAG (same port as flashing) --------
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# ---- Main task ------------------------------------------------------------
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# ---- Bluetooth: BLE only (the ESP32-S3 has no BR/EDR), Bluedroid + HID host
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_GATTC_ENABLE=y
CONFIG_BT_BLE_SMP_ENABLE=y
CONFIG_ESPHID_TASK_SIZE_BLE=4096

# Legacy (4.2) advertising and scanning is what HID-over-GATT gamepads use, and
# it is compiled out by default on targets other than the original ESP32.
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_BLE_50_FEATURES_SUPPORTED=n

# ---- FATFS long file names for ROMs on the TF card ------------------------
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
# The default API encoding is ANSI/OEM, which folds long filenames down to
# codepage 437 and destroys any non-ASCII name (Chinese ROM titles, for
# instance) before the application ever sees it. UTF-8 keeps them intact and
# lets the same string be handed back to fopen().
CONFIG_FATFS_API_ENCODING_UTF_8=y

# ---- Emulator performance -------------------------------------------------
# ESP-IDF defaults to -Og. The Game Boy core is the hot path of every frame and
# a CGB cartridge costs roughly 2.5x a DMG one, which -Og cannot fit in a frame;
# building for speed brings it back under.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# ---- Watchdog ------------------------------------------------------------
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# ---- Codecs ---------------------------------------------------------------
# Only the ES8311 (speaker) and ES7210 (microphone) drivers are vendored in
# components/esp_codec_dev; the rest are enabled by the component's Kconfig
# defaults but have no sources here.
CONFIG_CODEC_ES8311_SUPPORT=y
CONFIG_CODEC_ES7210_SUPPORT=y
CONFIG_CODEC_ES7243_SUPPORT=n
CONFIG_CODEC_ES7243E_SUPPORT=n
CONFIG_CODEC_ES8156_SUPPORT=n
CONFIG_CODEC_AW88298_SUPPORT=n
CONFIG_CODEC_ES8389_SUPPORT=n
CONFIG_CODEC_ES8374_SUPPORT=n
CONFIG_CODEC_ES8388_SUPPORT=n
CONFIG_CODEC_TAS5805M_SUPPORT=n
CONFIG_CODEC_ZL38063_SUPPORT=n
